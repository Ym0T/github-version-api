# Copy to .env and adjust. Never commit .env or private keys.

HOST=0.0.0.0
SERVER_PORT=3000

# Your repository. The short routes (/version, /diff/{repo}/...) use it.
DEFAULT_OWNER=Ym0T
DEFAULT_REPO=pterodactyl-nginx-egg

# Repositories this instance serves, comma-separated: owner/repo or
# owner/repo#id. The id is logged on the first request and is required for
# ZIP archives. "*" additionally serves read-only data for any public repo.
ALLOWED_REPOS=Ym0T/pterodactyl-nginx-egg

# Fine-grained token without access to private repositories (optional)
# GITHUB_TOKEN_FILE=/path/to/github.token
# or directly: GITHUB_TOKEN=github_pat_...

# ZIP archives, see SIGNING.md. They need a signing key and the public URL of
# this API for the download links.
# SIGNING_PRIVATE_KEY_FILE=/path/to/signing.key
# API_BASE_URL=https://api.example.com

# Only while you still have updaters that check the bare archive hash
# instead of the manifest:
# LEGACY_SIGNATURES=true

# Exact address of your reverse proxy (X-Forwarded-For is only trusted from it)
TRUSTED_PROXIES=127.0.0.1

# Browser origins allowed to call the API, comma-separated, or "*".
# Empty means no CORS.
# CORS_ALLOWED_ORIGINS=https://example.com

DATA_DIR=/home/container/data

RUST_LOG=info
